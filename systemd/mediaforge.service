[Unit]
Description=MediaForge (local media web UI)
After=network.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
# pipx で入れた yt-dlp (~/.local/bin) を見つけられるよう PATH を足す
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 7860
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
